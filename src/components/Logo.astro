---
// Brand mark: house outline with a sparkle, in the design's ink colour.
// The name comes from site config, so the mark keeps working when the real name is set.
import { site } from '../config/site';
interface Props { size?: number; class?: string }
const { size = 32, class: cls } = Astro.props;
---
<span class:list={['logo', cls]}>
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="logo__mark">
    <circle cx="16" cy="16" r="16" fill="currentColor" />
    <path d="M8.5 15.2L16 8.6l7.5 6.6M10.6 13.5V23.4h10.8V13.5" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M16 14.6l1.05 2.75 2.75 1.05-2.75 1.05L16 22.2l-1.05-2.75-2.75-1.05 2.75-1.05z" fill="#fff" />
  </svg>
  <span class="logo__name">{site.name}</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); }
  .logo__mark { flex: none; }
  .logo__name { letter-spacing: -0.02em; font-weight: 700; font-size: 18px; line-height: 1.2; }
</style>
