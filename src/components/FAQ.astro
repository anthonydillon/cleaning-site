---
interface Props { faqs: { q: string; a: string }[] }
const { faqs } = Astro.props;
---
{faqs.map((f) => (
  <details class="faq">
    <summary>{f.q}</summary>
    <p class="muted">{f.a}</p>
  </details>
))}

<style>
  .faq { border: 1px solid var(--line); border-radius: 16px; padding: 0 16px; background: #fff; max-width: 820px; }
  summary { min-height: 52px; display: flex; align-items: center; justify-content: space-between; gap: 12px; font-weight: 700; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-weight: 400; font-size: 22px; line-height: 1; }
  details[open] summary::after { content: '−'; }
  p { margin: 0 0 16px; }
</style>
