---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { site } from '../config/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const links = [
  ...services.map((s) => ({ href: `/${s.id}/`, label: s.data.nav })),
  { href: '/prices/', label: 'Prices' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header class="header">
  <div class="container header__inner">
    <div class="header__top">
      <a href="/" class="home-link" aria-label={`${site.name}, home`}><Logo /></a>
      <a href="/free-quote/" class="btn btn--primary header__cta" data-track="quote">Free quote</a>
    </div>
    <nav aria-label="Main" class="nav">
      {links.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .header { padding: 16px var(--gutter) 6px; }
  .header__inner { display: flex; flex-direction: column; gap: 6px; }
  .header__top { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .home-link { text-decoration: none; min-width: 0; }
  .header__cta { min-height: 44px; padding: 0 18px; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; }
  .nav { display: flex; column-gap: 22px; overflow-x: auto; scrollbar-width: none; }
  .nav::-webkit-scrollbar { display: none; }
  .nav a {
    flex: none; display: inline-flex; align-items: center; min-height: 44px;
    font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--muted); text-decoration: none;
  }
  .nav a:hover { color: var(--ink); }
  .nav a[aria-current='page'] { color: var(--ink); text-decoration: underline; text-underline-offset: 6px; }
</style>
