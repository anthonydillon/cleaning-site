---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickBar from '../components/QuickBar.astro';
import { localBusiness, breadcrumbSchema } from '../lib/schema';
import { site } from '../config/site';
// Self-hosted Instrument Sans (latin, variable weight): no Google Fonts request, no render blocking
import fontUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string; // full <title>, as set in the SEO plan
  description: string;
  schema?: Record<string, unknown>[];
  breadcrumbs?: { name: string; path: string }[];
  noindex?: boolean;
}
const { title, description, schema = [], breadcrumbs, noindex = false } = Astro.props;
const siteUrl = Astro.site!;
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const jsonLd = [localBusiness(siteUrl), ...schema];
if (breadcrumbs?.length) jsonLd.push(breadcrumbSchema(siteUrl, breadcrumbs));
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={`@font-face{font-family:'Instrument Sans';font-style:normal;font-display:swap;font-weight:400 700;src:url(${fontUrl}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.jpg', siteUrl).toString()} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <!-- TODO: GA4 / Google Tag Manager snippet. Lead events are pushed to window.dataLayer. -->
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <QuickBar />
    <script>
      // Each lead action is a separate conversion: call, whatsapp, book, quote, email
      window.dataLayer = window.dataLayer || [];
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
        if (el) window.dataLayer.push({ event: 'lead_click', lead_type: el.dataset.track, page: location.pathname });
      });
    </script>
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: -9999px; top: 0; z-index: 100; background: var(--ink); color: #fff; padding: 12px 16px; }
  .skip:focus { left: 0; }
</style>
