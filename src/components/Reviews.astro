---
import { reviews } from '../data/reviews';
import { site } from '../config/site';
interface Props { limit?: number; rating?: boolean; grid?: boolean }
const { limit, rating = true, grid = true } = Astro.props;
const list = limit ? reviews.slice(0, limit) : reviews;
---
{rating && (
  <div class="rating display">
    <span aria-hidden="true">★</span>
    {site.rating ? <><strong>{site.rating.value}</strong> · {site.rating.count} reviews</> : <><strong>[rating]</strong> · [number] reviews</>}
  </div>
)}
<div class:list={[{ 'grid grid--cards': grid }, 'reviews']}>
  {list.map((r) => (
    <figure class="review">
      <figcaption class="review__who">
        <span class="review__avatar" aria-hidden="true"></span>
        <span class="review__meta"><strong>{r.name}, {r.area}</strong><span class="muted">{r.date} · {r.source}</span></span>
      </figcaption>
      <blockquote class="muted measure">{r.text}</blockquote>
    </figure>
  ))}
</div>

<style>
  .rating { font-size: 24px; }
  .reviews { gap: 14px; }
  .review { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .review__who { display: flex; align-items: center; gap: 10px; }
  .review__avatar { width: 40px; height: 40px; border-radius: 999px; background: var(--avatar); flex: none; }
  .review__meta { display: flex; flex-direction: column; line-height: 1.35; font-size: 13px; }
  blockquote { margin: 0; }
</style>
