---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="Sorry, we couldn't find that page." noindex>
  <section class="section">
    <div class="container" style="text-align:center; max-width:640px">
      <h1>Page not found</h1>
      <p class="muted">Sorry, we couldn't find that page.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary" href="/">Go to homepage</a>
        <a class="btn btn--secondary" href="/free-quote/">Get a free quote</a>
      </div>
    </div>
  </section>
</BaseLayout>
